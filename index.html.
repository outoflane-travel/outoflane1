<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="OUTOFLANE — discover destinations, culture, nature and memorable journeys across India.">
  <meta name="theme-color" content="#123d36">
  <title>OUTOFLANE | Discover India Beyond the Usual</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --green: #123d36;
      --green2: #1d5147;
      --cream: #f5f2e9;
      --sand: #e8e0d1;
      --ink: #1d2824;
      --muted: #6d7771;
      --orange: #d47d4d;
      --white: #fff;
      --serif: 'Playfair Display', Georgia, serif;
      --sans: 'DM Sans', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    }

    [data-theme="dark"] {
      --green: #2dd4bf;
      --green2: #14352e;
      --cream: #091714;
      --sand: #122823;
      --ink: #f0f6f3;
      --muted: #8aa398;
      --orange: #f28b5b;
      --white: #122b25;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      font-family: var(--sans);
      line-height: 1.6;
      transition: background 0.25s, color 0.25s;
    }
    a { color: inherit; text-decoration: none; }

    .site-header {
      height: 82px;
      padding: 0 6.5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--cream);
      position: sticky;
      top: 0;
      z-index: 20;
      border-bottom: 1px solid #e7e2d8;
    }
    [data-theme="dark"] .site-header { border-bottom-color: #23453d; }

    .brand {
      display: flex;
      gap: 10px;
      align-items: center;
      font-size: 17px;
      font-weight: 700;
      letter-spacing: 2px;
      line-height: 1.15;
    }
    .brand small { display: block; font-size: 8px; letter-spacing: 1.5px; color: var(--muted); margin-top: 5px; }
    .brand-mark {
      width: 37px;
      height: 37px;
      border: 1px solid var(--orange);
      border-radius: 50%;
      display: grid;
      place-items: center;
      font: 700 22px var(--serif);
      color: var(--orange);
    }

    nav { display: flex; gap: 30px; font-size: 12px; font-weight: 600; color: var(--muted); }
    nav a:hover, .footer a:hover { color: var(--orange); }

    .nav-cta {
      background: var(--green);
      color: white;
      padding: 12px 17px;
      border-radius: 2px;
      font-size: 12px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
    }
    .nav-cta span { padding-left: 10px; }

    .theme-btn {
      background: var(--white);
      border: 1px solid #dcd6c9;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      margin-right: 12px;
    }
    [data-theme="dark"] .theme-btn { border-color: #23453d; }

    .menu-toggle { display: none; background: none; border: 0; font-size: 25px; cursor: pointer; color: var(--ink); }

    /* Hero */
    .hero {
      min-height: 620px;
      background: linear-gradient(90deg, rgba(7,31,27,.82), rgba(7,31,27,.18)),
                  url('https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?auto=format&fit=crop&w=2000&q=85') center 48%/cover;
      position: relative;
      color: white;
      display: flex;
      align-items: center;
      padding: 80px 10%;
    }
    .hero-content { max-width: 620px; position: relative; }
    .eyebrow { font-size: 10px; letter-spacing: 2.4px; font-weight: 700; color: var(--orange); margin: 0 0 18px; text-transform: uppercase; }
    .eyebrow.light { color: #e5b28f; }

    .hero h1, .feature-copy h2, .planner h2, .about h2, .contact-section h2 {
      font: 700 clamp(44px, 6.5vw, 80px)/1.05 var(--serif);
      letter-spacing: -2px;
      margin: 0 0 22px;
    }
    .hero h1 em, .feature-copy h2 em, .planner h2 em, .about h2 em, .contact-section h2 em {
      font-weight: 400;
      font-style: italic;
      color: #e8b28c;
    }
    .hero-copy { max-width: 440px; color: #e5e9e4; font-size: 15px; margin-bottom: 32px; }

    .button {
      display: inline-flex;
      gap: 20px;
      align-items: center;
      padding: 15px 22px;
      border: 0;
      border-radius: 2px;
      font: 700 12px var(--sans);
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .button-light { background: var(--cream); color: #123d36; }
    .button-outline { border: 1px solid #c4d0c8; color: white; background: transparent; }

    .hero-note {
      position: absolute;
      bottom: 28px;
      left: 10%;
      right: 10%;
      display: flex;
      justify-content: space-between;
      font-size: 9px;
      letter-spacing: 2px;
      color: #e4e6e0;
      font-weight: 600;
    }

    .section-wrap { padding: 100px 9%; border-bottom: 1px solid #e7e2d8; }
    [data-theme="dark"] .section-wrap { border-bottom-color: #23453d; }

    .intro { display: grid; grid-template-columns: 1fr 1fr; gap: 10%; align-items: end; }
    .intro h2, .section-heading h2 { font: 700 clamp(34px, 4vw, 52px)/1.1 var(--serif); letter-spacing: -1px; margin: 0; }
    .intro-copy { max-width: 480px; color: var(--muted); font-size: 14px; }

    .text-link {
      display: inline-block;
      margin-top: 14px;
      color: var(--green);
      font-weight: 700;
      font-size: 12px;
      border-bottom: 1px solid var(--orange);
      padding-bottom: 5px;
    }
    .text-link span { margin-left: 14px; }

    .section-heading { display: flex; justify-content: space-between; align-items: end; margin-bottom: 38px; gap: 20px; }
    .section-heading > p { font-size: 12px; color: var(--muted); margin: 0; }

    /* Search & Grid */
    .search-panel { display: flex; gap: 12px; align-items: center; margin-bottom: 25px; flex-wrap: wrap; }
    .search-box {
      background: var(--white);
      border: 1px solid #e7e1d7;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 15px;
      flex: 1;
      min-width: 260px;
      height: 48px;
      border-radius: 2px;
    }
    .search-box span { font-size: 22px; color: var(--orange); }
    .search-box input { border: 0; outline: 0; width: 100%; font: 13px var(--sans); background: transparent; color: var(--ink); }
    .search-panel select, .planner-form select {
      height: 48px;
      border: 1px solid #e7e1d7;
      background: var(--white);
      padding: 0 14px;
      color: var(--ink);
      font: 12px var(--sans);
      border-radius: 2px;
    }
    .result-count { font-size: 11px; color: var(--muted); white-space: nowrap; font-weight: 600; }

    .destination-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .destination-card {
      background: var(--white);
      min-height: 230px;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: transform .2s, box-shadow .2s;
      border: 1px solid #eee9df;
      border-radius: 2px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .destination-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,.08); }
    .card-top { height: 8px; background: var(--card-color, var(--green)); }
    .destination-card .card-content { padding: 22px; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
    .card-region { font-size: 9px; letter-spacing: 1.7px; color: var(--orange); font-weight: 700; text-transform: uppercase; }
    .destination-card h3 { font: 700 24px var(--serif); margin: 7px 0 8px; }
    .destination-card p { font-size: 11px; color: var(--muted); margin: 0 0 14px; line-height: 1.5; }
    .card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      color: var(--muted);
      border-top: 1px solid #f0ede7;
      padding-top: 12px;
    }
    .card-bottom b { color: var(--green); font-size: 16px; }

    .empty-state { padding: 40px; text-align: center; color: var(--muted); font-size: 13px; }

    /* Feature Band */
    .feature-band { display: grid; grid-template-columns: 1fr 1fr; background: var(--green); color: white; min-height: 500px; }
    .feature-image {
      background: url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=85') center/cover;
      min-height: 400px;
    }
    .feature-copy { padding: 75px 12%; align-self: center; }
    .feature-copy h2 { font-size: clamp(38px, 4.5vw, 60px); }
    .feature-copy > p:not(.eyebrow) { font-size: 13px; color: #d2ded8; max-width: 400px; margin-bottom: 28px; line-height: 1.6; }

    /* Grids */
    .experience-grid, .idea-grid, .journal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .experience-card { padding: 26px; background: #eae5d9; min-height: 180px; border-radius: 2px; }
    .experience-icon { font-size: 25px; }
    .experience-card h3 { font: 700 21px var(--serif); margin: 12px 0 6px; }
    .experience-card p { font-size: 12px; color: var(--muted); margin: 0; }
    .experience-card small { color: var(--orange); font-size: 9px; letter-spacing: 1.4px; text-transform: uppercase; font-weight: 700; }

    /* Planner */
    .planner { background: var(--green); color: white; padding: 90px 9%; }
    .planner-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 10%; max-width: 1100px; margin: auto; }
    .planner h2 { font-size: clamp(40px, 4.5vw, 60px); }
    .planner-inner > div > p:not(.eyebrow) { color: #d2ded8; font-size: 13px; max-width: 360px; line-height: 1.6; }
    .planner-form { display: grid; gap: 14px; }
    .planner-form label { display: grid; gap: 7px; font-size: 11px; color: #dce5df; font-weight: 600; text-transform: uppercase; }
    .planner-form label span { float: right; color: #f2ad87; }
    .planner-form select { width: 100%; border: 0; background: white; color: #123d36; font-weight: 600; }
    .planner-form input[type=range] { width: 100%; accent-color: #e5b28f; cursor: pointer; }
    .planner-form .button { justify-content: space-between; margin-top: 8px; }
    .form-note { font-size: 9px; color: #b8c9c0; margin: 0; }
    .trip-result {
      max-width: 1100px;
      margin: 25px auto 0;
      padding: 22px;
      background: #1c5147;
      border-left: 4px solid #e5b28f;
      font-size: 13px;
      border-radius: 2px;
      line-height: 1.6;
    }

    /* Ideas & Journal */
    .idea-card { padding: 28px; background: #eae5d9; min-height: 210px; border-radius: 2px; }
    .idea-card .number { font: 700 38px var(--serif); color: #c9a68d; }
    .idea-card h3 { font: 700 22px var(--serif); margin: 5px 0; }
    .idea-card p { font-size: 12px; color: var(--muted); margin: 0; }
    .idea-card small { font-size: 10px; color: var(--orange); font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }

    .journal-card { background: var(--white); padding: 25px; min-height: 190px; border-radius: 2px; border: 1px solid #eee9df; }
    .journal-card small { font-size: 9px; color: var(--orange); letter-spacing: 1.5px; text-transform: uppercase; font-weight: 700; }
    .journal-card h3 { font: 700 22px var(--serif); margin: 12px 0 8px; }
    .journal-card p { font-size: 12px; color: var(--muted); margin: 0; }

    .about {
      background: linear-gradient(90deg, rgba(16,47,43,.96), rgba(16,47,43,.82)),
                  url('https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1800&q=80') center/cover;
      padding: 100px 9%;
      color: white;
    }
    .about-inner { max-width: 680px; }
    .about h2 { font-size: clamp(40px, 5vw, 65px); }
    .about-inner > p:not(.eyebrow) { max-width: 560px; color: #d4ded8; font-size: 14px; line-height: 1.6; }
    .light-link { color: white; }

    /* Contact Section */
    .contact-section {
      padding: 90px 9%;
      background: var(--sand);
      border-top: 1px solid #dcd6c9;
    }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10%;
      max-width: 1100px;
      margin: auto;
    }
    .contact-form {
      background: var(--white);
      padding: 30px;
      border-radius: 2px;
      border: 1px solid #e7e1d7;
      display: grid;
      gap: 14px;
    }
    .contact-form label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; }
    .contact-form input, .contact-form select, .contact-form textarea {
      width: 100%;
      padding: 11px 13px;
      border: 1px solid #e7e1d7;
      background: var(--cream);
      color: var(--ink);
      font: 13px var(--sans);
      border-radius: 2px;
      margin-top: 4px;
      outline: none;
    }

    /* Footer */
    .footer { background: #102c28; color: white; padding: 45px 9% 30px; }
    .footer-top, .footer-bottom { display: flex; justify-content: space-between; align-items: center; }
    .brand-footer .brand-mark { border-color: #d6e0d9; color: white; }
    .brand-footer small { color: #b6c7bf; }
    .footer-top > p { font: italic 17px var(--serif); color: #d5b49b; margin: 0; }
    .footer-bottom { border-top: 1px solid #35534c; margin-top: 32px; padding-top: 20px; font-size: 11px; color: #b8c9c0; }
    .footer-bottom div { display: flex; gap: 22px; }
    .disclaimer { font-size: 10px; color: #8fa59b; margin: 20px 0 0; max-width: 900px; line-height: 1.5; }

    /* Modal */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 40;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal.open { display: flex; }
    .modal-backdrop { position: absolute; inset: 0; background: rgba(7, 29, 25, 0.85); }
    .modal-card {
      position: relative;
      background: var(--cream);
      width: min(660px, 100%);
      max-height: 88vh;
      overflow-y: auto;
      padding: 40px;
      border-radius: 2px;
      z-index: 10;
    }
    .modal-close {
      position: absolute;
      right: 16px;
      top: 12px;
      border: 0;
      background: none;
      font-size: 28px;
      cursor: pointer;
      color: var(--ink);
    }
    .modal-card h2 { font: 700 36px var(--serif); margin: 8px 0; }
    .modal-card p, .modal-card li { font-size: 13px; color: var(--muted); }
    .modal-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 20px 0; }
    .fact { background: #eae5d9; padding: 14px; border-radius: 2px; }
    .fact small { display: block; color: var(--orange); font-size: 9px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }
    .fact b { font-size: 12px; color: var(--ink); }
    .modal-card h3 { font: 700 20px var(--serif); margin-top: 20px; }
    .modal-card .button { margin-top: 16px; background: var(--green); color: white; width: 100%; justify-content: center; }

    /* Dark Mode Theme Rules */
    [data-theme="dark"] .site-header,
    [data-theme="dark"] .search-box,
    [data-theme="dark"] .destination-card,
    [data-theme="dark"] .journal-card,
    [data-theme="dark"] .search-panel select,
    [data-theme="dark"] .modal-card,
    [data-theme="dark"] .contact-form {
      background: var(--white);
      color: var(--ink);
      border-color: #23453d;
    }
    [data-theme="dark"] .experience-card,
    [data-theme="dark"] .idea-card,
    [data-theme="dark"] .fact {
      background: var(--sand);
      color: var(--ink);
    }
    [data-theme="dark"] .contact-form input,
    [data-theme="dark"] .contact-form select,
    [data-theme="dark"] .contact-form textarea {
      border-color: #23453d;
      background: var(--cream);
      color: var(--ink);
    }

    @media(max-width: 850px) {
      nav { gap: 14px; }
      .nav-cta { display: none; }
      .destination-grid, .experience-grid, .idea-grid, .journal-grid { grid-template-columns: repeat(2, 1fr); }
      .section-wrap { padding: 75px 6%; }
      .hero { min-height: 560px; padding: 70px 7%; }
      .feature-copy { padding: 60px 8%; }
      .planner { padding: 75px 7%; }
      .contact-grid { grid-template-columns: 1fr; gap: 30px; }
    }
    @media(max-width: 620px) {
      .site-header { height: 70px; padding: 0 5%; }
      .menu-toggle { display: block; }
      nav {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        background: var(--cream);
        padding: 20px 6%;
        flex-direction: column;
        box-shadow: 0 12px 20px rgba(0,0,0,.15);
      }
      nav.open { display: flex; }
      .hero { min-height: 540px; }
      .hero h1 { font-size: 46px; }
      .intro, .planner-inner, .feature-band { grid-template-columns: 1fr; gap: 25px; }
      .feature-image { min-height: 260px; }
      .destination-grid, .experience-grid, .idea-grid, .journal-grid { grid-template-columns: 1fr; }
      .footer-top, .footer-bottom { align-items: flex-start; gap: 18px; flex-direction: column; }
    }
  </style>
</head>
<body>

<header class="site-header">
  <a class="brand" href="#" aria-label="OUTOFLANE home">
    <span class="brand-mark">O</span>
    <span>OUTOFLANE<small>DISCOVER BEYOND THE USUAL</small></span>
  </a>
  <button class="menu-toggle" id="menuToggle" aria-label="Open menu">☰</button>
  <nav id="mainNav">
    <a href="#destinations">Destinations</a>
    <a href="#experiences">Experiences</a>
    <a href="#journeys">Trip ideas</a>
    <a href="#journal">Travel journal</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>
  <div style="display:flex; align-items:center;">
    <button class="theme-btn" id="themeToggle" aria-label="Toggle light or dark theme" title="Toggle Theme">🌓</button>
    <a class="nav-cta" href="#planner">Plan a trip <span>↗</span></a>
  </div>
</header>

<main>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow light">A LITTLE CLOSER TO THE UNEXPECTED</p>
      <h1>Find your own<br><em>way out there.</em></h1>
      <p class="hero-copy">From quiet mountain towns to colourful old streets, discover the many stories of India across all 36 states and union territories.</p>
      <a class="button button-light" href="#destinations">Explore destinations <span>→</span></a>
    </div>
    <div class="hero-note">
      <span>01 / 36</span>
      <span>36 STATES &amp; UNION TERRITORIES</span>
    </div>
  </section>

  <!-- Intro -->
  <section class="intro section-wrap">
    <div>
      <p class="eyebrow">TRAVEL WITH CURIOSITY</p>
      <h2>India is not just<br>one destination.</h2>
    </div>
    <div class="intro-copy">
      <p>It is a collection of landscapes, flavours, traditions and unforgettable moments. OUTOFLANE helps you find places to go, things to experience and ideas to shape a journey that feels like yours.</p>
      <a class="text-link" href="#about">Get to know our philosophy <span>↗</span></a>
    </div>
  </section>

  <!-- Destinations Directory -->
  <section class="destinations section-wrap" id="destinations">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THE DESTINATION EDIT</p>
        <h2>Where will you go?</h2>
      </div>
      <p>Explore all 36 states and union territories<br>and find a place that calls to you.</p>
    </div>
    <div class="search-panel">
      <div class="search-box">
        <span>⌕</span>
        <input id="searchInput" type="search" placeholder="Search a state, city, capital, or vibe…">
      </div>
      <select id="regionFilter" aria-label="Filter by region">
        <option value="All">All regions</option>
        <option>North India</option>
        <option>South India</option>
        <option>East India</option>
        <option>West India</option>
        <option>Central India</option>
        <option>North East India</option>
        <option>Islands</option>
      </select>
      <span class="result-count" id="resultCount">36 destinations</span>
    </div>
    <div class="destination-grid" id="destinationGrid"></div>
    <p class="empty-state" id="emptyState" style="display:none;">No destinations match your search. Try another keyword or region.</p>
  </section>

  <!-- Feature Band -->
  <section class="feature-band" id="experiences">
    <div class="feature-image"></div>
    <div class="feature-copy">
      <p class="eyebrow light">GO BEYOND THE CHECKLIST</p>
      <h2>Collect moments,<br><em>not just miles.</em></h2>
      <p>Find meaningful ways to connect with the places you visit — through food, heritage, nature and local culture.</p>
      <a class="button button-outline" href="#journeys">Find your experience <span>→</span></a>
    </div>
  </section>

  <!-- Experiences Grid -->
  <section class="experiences section-wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">MAKE IT YOURS</p>
        <h2>Experiences to remember</h2>
      </div>
      <p>Every journey has a different rhythm.<br>Choose the kind of discovery you love.</p>
    </div>
    <div class="experience-grid" id="experienceGrid"></div>
  </section>

  <!-- Interactive Planner -->
  <section class="planner" id="planner">
    <div class="planner-inner">
      <div>
        <p class="eyebrow light">START WITH AN IDEA</p>
        <h2>Your next story<br>starts <em>somewhere.</em></h2>
        <p>Build a simple trip outline with a destination, travel style and number of days.</p>
      </div>
      <form id="tripForm" class="planner-form">
        <label>
          Where would you like to go?
          <select id="tripDestination" required>
            <option value="">Choose a destination</option>
          </select>
        </label>
        <label>
          What kind of trip?
          <select id="tripStyle">

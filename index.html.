// ==========================================
// 2. INTERACTIVE SCRIPT LOGIC
// ==========================================
const palette = ["#1d5147", "#c47b50", "#687d69", "#b58b62", "#496a7a", "#92745f"];

function renderDestinations() {
  const q = (document.getElementById("searchInput").value || "").toLowerCase().trim();
  const region = document.getElementById("regionFilter").value;
  const filtered = data.filter(s => (region === "All" || s.region === region) &&
    [s.name, s.capital, s.region, ...s.places, s.vibe].join(" ").toLowerCase().includes(q));

  document.getElementById("resultCount").textContent = `${filtered.length} destination${filtered.length === 1 ? "" : "s"}`;
  document.getElementById("emptyState").style.display = filtered.length === 0 ? "block" : "none";

  document.getElementById("destinationGrid").innerHTML = filtered.map(s => `
    <article class="destination-card" tabindex="0" role="button" data-state="${encodeURIComponent(s.name)}" style="--card-color:${palette[data.indexOf(s) % palette.length]}">
      <div class="card-top"></div>
      <div class="card-content">
        <span class="card-region">${s.region}</span>
        <h3>${s.name}</h3>
        <p>${s.vibe}</p>
        <div class="card-bottom">
          <span>Capital: <strong>${s.capital}</strong></span>
          <b>↗</b>
        </div>
      </div>
    </article>
  `).join("");
}

function showDestination(name) {
  const s = data.find(x => x.name === name);
  if (!s) return;
  document.getElementById("modalContent").innerHTML = `
    <p class="eyebrow">${s.region}</p>
    <h2>${s.name}</h2>
    <p>${s.vibe}.</p>
    <div class="modal-facts">
      <div class="fact"><small>Capital</small><b>${s.capital}</b></div>
      <div class="fact"><small>Suggested duration</small><b>${s.duration}</b></div>
      <div class="fact"><small>Good time to visit</small><b>${s.season}</b></div>
      <div class="fact"><small>Travel style</small><b>Mindful discovery</b></div>
    </div>
    <h3>Places to explore</h3>
    <ul style="margin: 8px 0 20px 20px; font-size:13px; color:var(--muted);">
      ${s.places.map(p => `<li>${p}</li>`).join("")}
    </ul>
    <button class="button" onclick="planForDestination('${s.name}')">Plan a Trip in Trip Planner →</button>
  `;
  const m = document.getElementById("destinationModal");
  m.classList.add("open");
  m.setAttribute("aria-hidden", "false");
}

function planForDestination(name) {
  closeModal();
  const sel = document.getElementById("tripDestination");
  if (sel) sel.value = name;
  const p = document.getElementById("planner");
  if (p) p.scrollIntoView({ behavior: "smooth" });
}

function closeModal() {
  const m = document.getElementById("destinationModal");
  m.classList.remove("open");
  m.setAttribute("aria-hidden", "true");
}

function renderExtras() {
  document.getElementById("experienceGrid").innerHTML = (extras.experiences || []).map((x, i) => `
    <article class="experience-card">
      <span class="experience-icon">${["⌁", "⌂", "✳", "◌", "♧", "≈"][i % 6]}</span>
      <small>${x.type}</small>
      <h3>${x.name}</h3>
      <p>${x.description}</p>
    </article>
  `).join("");

  document.getElementById("packageGrid").innerHTML = (extras.samplePackages || []).map((x, i) => `
    <article class="idea-card">
      <span class="number">0${i + 1}</span>
      <small>${x.duration} · ${x.style}</small>
      <h3>${x.name}</h3>
      <p>${x.description}</p>
    </article>
  `).join("");

  document.getElementById("articleGrid").innerHTML = (extras.articles || []).map(x => `
    <article class="journal-card">
      <small>${x.category}</small>
      <h3>${x.title}</h3>
      <p>${x.description}</p>
    </article>
  `).join("");
}

function setup() {
  // Theme toggle with localStorage support
  const themeBtn = document.getElementById("themeToggle");
  let dark = false;
  try { dark = localStorage.getItem("out_theme") === "dark"; } catch(e) {}
  if (dark) document.documentElement.setAttribute("data-theme", "dark");

  if (themeBtn) {
    themeBtn.addEventListener("click", () => {
      dark = !dark;
      if (dark) {
        document.documentElement.setAttribute("data-theme", "dark");
      } else {
        document.documentElement.removeAttribute("data-theme");
      }
      try { localStorage.setItem("out_theme", dark ? "dark" : "light"); } catch(e) {}
    });
  }

  // Click & Keydown listeners on destination grid
  const grid = document.getElementById("destinationGrid");
  grid.addEventListener("click", e => {
    const card = e.target.closest("[data-state]");
    if (card) showDestination(decodeURIComponent(card.dataset.state));
  });
  grid.addEventListener("keydown", e => {
    if ((e.key === "Enter" || e.key === " ") && e.target.matches("[data-state]")) {
      e.preventDefault();
      showDestination(decodeURIComponent(e.target.dataset.state));
    }
  });

  // Search & Filter listeners
  document.getElementById("searchInput").addEventListener("input", renderDestinations);
  document.getElementById("regionFilter").addEventListener("change", renderDestinations);

  // Populate trip destination dropdown
  const tripSelect = document.getElementById("tripDestination");
  tripSelect.innerHTML += data.map(s => `<option value="${s.name}">${s.name} (${s.region})</option>`).join("");

  // Days Slider
  document.getElementById("tripDays").addEventListener("input", e => {
    document.getElementById("daysValue").textContent = `${e.target.value} day${e.target.value === "1" ? "" : "s"}`;
  });

  // Trip Idea Planner Submission
  document.getElementById("tripForm").addEventListener("submit", e => {
    e.preventDefault();
    const dest = document.getElementById("tripDestination").value;
    const style = document.getElementById("tripStyle").value;
    const days = document.getElementById("tripDays").value;
    const s = data.find(x => x.name === dest);
    const res = document.getElementById("tripResult");
    res.style.display = "block";
    res.innerHTML = `
      <strong>Your ${days}-day ${style.toLowerCase()} journey in ${dest}</strong><br>
      Start with exploring: ${s.places.slice(0, 3).join(", ")}.<br>
      Suggested overall visit pace: <strong>${s.duration}</strong>. Best season: <strong>${s.season}</strong>.<br>
      <em>Adjust the pace to suit your interests and check current local information before travelling.</em>
    `;
  });

  // Mobile menu toggle
  document.getElementById("menuToggle").addEventListener("click", () => {
    document.getElementById("mainNav").classList.toggle("open");
  });

  // Modal dismiss handlers
  document.querySelectorAll("[data-close]").forEach(x => x.addEventListener("click", closeModal));
  document.addEventListener("keydown", e => { if (e.key === "Escape") closeModal(); });

  // Contact Form
  const cForm = document.getElementById("contactForm");
  if (cForm) {
    cForm.addEventListener("submit", e => {
      e.preventDefault();
      document.getElementById("cSuccess").style.display = "block";
    });
  }

  // Footer year
  document.getElementById("year").textContent = new Date().getFullYear();

  // Initial renders
  renderDestinations();
  renderExtras();
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", setup);
} else {
  setup();
}
</script>
